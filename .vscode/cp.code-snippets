  "busqueda binaria": {
    "scope": "cpp",
    "prefix": "bs",
    "body": [
      "auto check = [&](long long ${1:x}) -> bool {",
      "\t$0",
      "};",
      "long long lo = ${2:0}, hi = ${3:1e18}, ans = -1;",
      "while (lo <= hi) {",
      "\tlong long mid = lo + (hi - lo) / 2;",
      "\tif (check(mid)) ans = mid, hi = mid - 1;",
      "\telse lo = mid + 1;",
      "}"
