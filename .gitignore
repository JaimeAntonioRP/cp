# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# ---------------------------------------------------------------- cpx ------
# Binarios compilados por `cpx run/test/stress`
bin/
*.stackdump

# IMPORTANTE: `*.out` (arriba) es la extension de los ejecutables de Unix, pero
# tambien la que usamos para la salida esperada de los tests. Estas excepciones
# garantizan que los casos de prueba SI se versionen.
!**/tests/*.out
!**/tests/*.ans
!**/tests/*.in
